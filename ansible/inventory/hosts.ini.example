# Example of the static, SSH-based fallback inventory. The real file is
# generated by `terraform apply` (infra/aws/inventory.tf) or
# infra/aws/scripts/gen-inventory.sh, and is gitignored.
#
# Prefer inventory/aws_ec2.yml (dynamic, SSM-based) for day-to-day use.

[okd_masters]
okd-master ansible_host=203.0.113.10 private_ip=10.50.0.10 ansible_user=fedora

[okd_workers]
okd-worker ansible_host=10.50.10.10 private_ip=10.50.10.10 ansible_user=fedora

[control]
okd-ansible ansible_host=203.0.113.11 private_ip=10.50.0.11 ansible_user=ubuntu

[runner]
okd-runner ansible_host=203.0.113.12 private_ip=10.50.0.12 ansible_user=ubuntu

[okd_cluster:children]
okd_masters
okd_workers

[okd_cluster:vars]
ansible_ssh_private_key_file=~/.ssh/okd-project.pem
ansible_ssh_common_args=-o StrictHostKeyChecking=accept-new
