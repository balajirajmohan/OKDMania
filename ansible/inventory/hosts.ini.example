# ===========================================================================
# EXAMPLE inventory - committed to git. The real inventory/hosts.ini is
# GENERATED from Terraform outputs and is gitignored (it holds live IPs).
#
# Generate the real one, either way:
#   * `terraform apply` in infra/aws/sandbox/environments/sandbox
#       -> inventory.tf writes this repo's ansible/inventory/hosts.ini
#   * infra/aws/sandbox/scripts/gen-inventory.sh
#       -> parses `terraform output -json`
#
# NEVER hard-code the dynamic IPs below into a committed file (spec section 18).
# ===========================================================================

[okd_masters]
okd-master ansible_host=<MASTER_PUBLIC_IP> private_ip=<MASTER_PRIVATE_IP> ansible_user=fedora

[okd_workers]
okd-worker ansible_host=<WORKER_PUBLIC_IP> private_ip=<WORKER_PRIVATE_IP> ansible_user=fedora

[control]
okd-ansible ansible_host=<ANSIBLE_PUBLIC_IP> private_ip=<ANSIBLE_PRIVATE_IP> ansible_user=ubuntu

[runner]
okd-runner ansible_host=<RUNNER_PUBLIC_IP> private_ip=<RUNNER_PRIVATE_IP> ansible_user=ubuntu

[okd_cluster:children]
okd_masters
okd_workers

[okd_cluster:vars]
ansible_ssh_private_key_file=~/.ssh/okd-project.pem
ansible_ssh_common_args=-o StrictHostKeyChecking=accept-new
