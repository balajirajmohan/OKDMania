#cloud-config
# ===========================================================================
# Fedora node (OKD-Master / OKD-Worker) - BASIC OS PREP ONLY
# ===========================================================================
# This does NOT install OKD. OKD 4.x nodes run Fedora CoreOS + Ignition and are
# built by `openshift-install`; a plain Fedora Cloud VM cannot be turned into an
# OKD 4.x master/worker by Ansible. These boxes are a learning / tooling
# surface.
#
# Real OKD prerequisite configuration (kernel params, DNS, chrony policy,
# firewall, SELinux booleans, etc.) belongs in Ansible - Phase 2.
# ===========================================================================

hostname: ${hostname}
fqdn: ${hostname}.${internal_domain}
prefer_fqdn_over_hostname: true
manage_etc_hosts: true

package_update: true
package_upgrade: false   # keep first boot fast; patch via Ansible later

packages:
  - chrony
  - git
  - curl
  - wget
  - tar
  - bind-utils          # dig / nslookup - you WILL need these for OKD DNS
  - jq
  - htop
  - tcpdump
  - traceroute
  - policycoreutils-python-utils   # semanage - handy when debugging SELinux

write_files:
  - path: /etc/profile.d/okd-project.sh
    permissions: "0644"
    content: |
      # OKDMania node - ${hostname} (role: ${role})
      # Learning/tooling node, not an OKD 4.x cluster member.
      export OKD_ROLE=${role}

runcmd:
  - [ systemctl, enable, --now, chronyd ]
  - [ hostnamectl, set-hostname, "${hostname}" ]
  # Fedora Cloud Base does not ship the SSM Agent (unlike Amazon Linux /
  # Ubuntu) - install it so this node registers with Systems Manager and
  # Ansible can reach it over aws_ssm.
  - [ dnf, install, -y, "https://s3.${aws_region}.amazonaws.com/amazon-ssm-${aws_region}/latest/linux_amd64/amazon-ssm-agent.rpm" ]
  - [ systemctl, enable, --now, amazon-ssm-agent ]
  - [ bash, -c, "echo 'OKDMania ${role} node ready' > /etc/motd" ]

final_message: "cloud-init done: ${hostname} (${role}) up after $UPTIME s"
