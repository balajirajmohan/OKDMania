# ===========================================================================
# GENERATED by Terraform (infra/aws/inventory.tf) on apply.
# Do not edit by hand - your changes are overwritten. Do not commit (gitignored).
# Regenerate: `terraform apply` or scripts/gen-inventory.sh
# ===========================================================================
# SSM is the primary Ansible transport (see ansible/inventory/aws_ec2.yml).
# This static, SSH-based inventory is the fallback / break-glass path.
#
# ansible_host  = public IP for public-subnet nodes; the worker has none, so
#                 it uses its private IP - reachable in-VPC from okd-ansible.
# private_ip    = in-VPC address (use for node-to-node references)
# ansible_user  = cloud image default (fedora / ubuntu)

[okd_masters]
okd-master ansible_host=${master_public_ip} private_ip=${master_private_ip} ansible_user=fedora

[okd_workers]
okd-worker ansible_host=${worker_private_ip} private_ip=${worker_private_ip} ansible_user=fedora

[control]
okd-ansible ansible_host=${ansible_public_ip} private_ip=${ansible_private_ip} ansible_user=ubuntu

[runner]
okd-runner ansible_host=${runner_public_ip} private_ip=${runner_private_ip} ansible_user=ubuntu

[okd_cluster:children]
okd_masters
okd_workers

[okd_cluster:vars]
ansible_ssh_private_key_file=${ssh_private_key_file}
ansible_ssh_common_args=-o StrictHostKeyChecking=accept-new
